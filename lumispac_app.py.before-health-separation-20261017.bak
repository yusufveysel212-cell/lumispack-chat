# ==== GLOBAL ERROR HANDLER ====
@app.errorhandler(404)
def hata_404(e):
    """Bulunamayan endpoint."""
    return jsonify({
        'status': 'error',
        'kod': 404,
        'mesaj': 'Sayfa veya endpoint bulunamadi',
        'yol': request.path
    }), 404


@app.errorhandler(500)
def hata_500(e):
    """Beklenmeyen sunucu hatasi."""
    import traceback
    tb = traceback.format_exc()
    # Log'a yaz
    try:
        logging.error(f"[500] {request.method} {request.path}\n{tb}")
    except Exception:
        pass
    # Kullaniciya ozet don
    return jsonify({
        'status': 'error',
        'kod': 500,
        'mesaj': 'Sunucu hatasi olustu. Lutfen tekrar deneyin.',
        'yol': request.path
    }), 500


@app.errorhandler(Exception)
def hata_genel(e):
    """Yakalanmayan tum hatalar."""
    from werkzeug.exceptions import HTTPException
    # HTTP hatasi ise (404, 403 gibi) normal akisa birak
    if isinstance(e, HTTPException):
        return e
    # Beklenmeyen hata
    import traceback
    tb = traceback.format_exc()
    try:
        logging.error(f"[EXC] {request.method} {request.path}\n{tb}")
    except Exception:
        pass
    return jsonify({
        'status': 'error',
        'kod': 500,
        'mesaj': 'Beklenmeyen hata',
        'yol': request.path
    }), 500
# ==== /GLOBAL ERROR HANDLER ====


