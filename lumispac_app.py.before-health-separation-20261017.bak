@app.get('/api/system/health')
def system_health():
    """Administrator-only, read-only application and storage health snapshot."""
    started = time.monotonic()
    checked_at = datetime.now().isoformat(timespec='seconds')
    database = {'engine': str(getattr(__import__('config'), 'STORAGE_BACKEND', 'json')).upper(),
                'connected': False, 'integrity': 'error', 'schema_version': None,
                'rows': None, 'table_count': None}
    try:
        adapter = get_storage_adapter()
        if adapter is None:
            database.update({'connected': True, 'integrity': 'legacy-json'})
        else:
            check = adapter.integrity_check()
            database.update({'connected': True, 'integrity': check.get('integrity', 'error'),
                             'schema_version': check.get('schema_version'), 'rows': check.get('rows')})
            conn = adapter.connect(__import__('config').DATABASE_URL) if hasattr(adapter, 'connect') else adapter._connect()
            try:
                catalog_query = ("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=current_schema() AND table_type='BASE TABLE'"
                                 if getattr(adapter, "__name__", "") == "postgres_store"
                                 else "SELECT COUNT(*) FROM sqlite_master WHERE type='table'")
                database['table_count'] = conn.execute(catalog_query).fetchone()[0]
            finally:
                conn.close()
            database['connected'] = bool(check.get('ok'))
    except Exception:
        database['connected'] = False
        logging.exception('Yönetici sağlık kontrolü başarısız')
    backup_dir = __import__('config').BACKUP_DIR
    backup = {'name': None, 'age_hours': None, 'size_bytes': None, 'status': 'missing'}
    try:
        os.makedirs(backup_dir, exist_ok=True)
        candidates = []
        for name in os.listdir(backup_dir):
            if re.fullmatch(r'lumispac_full_\d{8}(?:_\d{6})?\.(?:dump|backup|sqlite3)', name):
                path = os.path.join(backup_dir, name)
                if os.path.isfile(path) and os.path.getsize(path) > 0:
                    candidates.append((os.path.getmtime(path), name, path))
        if candidates:
            stamp, name, path = max(candidates)
            age_hours = max(0, (time.time() - stamp) / 3600)
            backup.update({'name': name, 'age_hours': round(age_hours, 1),
                           'size_bytes': os.path.getsize(path), 'status': 'ok' if age_hours <= 26 else 'stale'})
    except Exception:
        logging.exception('Yönetici yedek kontrolü başarısız')
    disk = shutil.disk_usage(backup_dir)
    free_gb = round(disk.free / (1024 ** 3), 2)
    ok = database['connected'] and database['integrity'] in ('ok', 'legacy-json') and backup['status'] == 'ok' and free_gb >= 1
    return jsonify({'status': 'ok' if ok else 'warning', 'checked_at': checked_at,
                    'database': database, 'backup': backup,
                    'storage': {'free_gb': free_gb, 'total_gb': round(disk.total / (1024 ** 3), 2)},
                    'elapsed_ms': round((time.monotonic() - started) * 1000)})


